{
  "name": "sinio/sinio-php",
  "description": "Official PHP SDK for the sinio.ai ingestion API (events, entities, locations, assignments).",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.sinio.ai/sdks",
  "support": {
    "issues": "https://github.com/sinio-ai/sinio-php/issues",
    "source": "https://github.com/sinio-ai/sinio-php",
    "docs": "https://docs.sinio.ai/sdks"
  },
  "keywords": ["sinio", "events", "ingestion", "sdk"],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "Sinio\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sinio\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  },
  "config": {
    "sort-packages": true
  }
}
